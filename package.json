{
  "name": "reachinbox",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "dev:worker": "npm --workspace backend run worker",
    "build": "npm --workspace frontend run build && npm --workspace backend run build",
    "lint": "npm --workspace frontend run lint && npm --workspace backend run lint",
    "test": "npm --workspace backend run test",
    "db:generate": "npm --workspace backend run prisma:generate",
    "db:migrate": "npm --workspace backend run prisma:migrate",
    "docker:up": "docker compose up -d postgres redis elasticsearch",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
